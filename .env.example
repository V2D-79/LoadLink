# ============================================================
# LoadLink Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# All EXPO_PUBLIC_ variables are visible inside the app bundle.
# Restrict API keys at the provider level (domain/IP allowlist).
# ============================================================

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Map Tile Provider (MapTiler, Stadia Maps, or Thunderforest)
# WARNING: This key is embedded in the app bundle. Restrict it at the provider.
# Example for MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# Example for Stadia: https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}.png?api_key=YOUR_KEY
EXPO_PUBLIC_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
EXPO_PUBLIC_TILE_ATTRIBUTION=Map data © OpenStreetMap contributors, tiles © MapTiler

# OpenRouteService (free API key for routing)
# WARNING: This key is embedded in the app bundle. Use the free tier and restrict usage.
# Get a key at: https://openrouteservice.org/dev/#/signup
EXPO_PUBLIC_ORS_KEY=your_ors_api_key
